# Imagen de producción para Vercel (FrankenPHP).
# El Dockerfile "normal" sigue siendo el de desarrollo con docker-compose.

# PHP 8.3: phpoffice/phpspreadsheet todavía no soporta versiones más nuevas
FROM dunglas/frankenphp:1-php8.3-bookworm AS base

RUN cp "$PHP_INI_DIR/php.ini-production" "$PHP_INI_DIR/php.ini" \
    && install-php-extensions intl zip gd bcmath pdo_pgsql pdo_mysql

# Límites para subir Excel (Vercel corta igual los requests de más de 4.5 MB)
RUN printf "upload_max_filesize=20M\npost_max_size=20M\nmemory_limit=512M\nmax_execution_time=300\n" \
    > "$PHP_INI_DIR/conf.d/zz-app.ini"

WORKDIR /app

FROM base AS dependencies

COPY --from=composer:2 /usr/bin/composer /usr/bin/composer

COPY composer.json composer.lock ./
RUN composer install --no-dev --no-interaction --no-progress --no-scripts \
    --optimize-autoloader --prefer-dist

COPY . .
RUN mkdir -p storage/app/private storage/framework/cache storage/framework/sessions \
        storage/framework/views storage/logs bootstrap/cache \
    && rm -f bootstrap/cache/*.php \
    && composer dump-autoload --no-dev --classmap-authoritative \
    && php artisan view:cache

FROM base AS runtime

COPY --from=dependencies --chown=www-data:www-data /app /app
COPY Caddyfile /etc/frankenphp/Caddyfile

RUN setcap CAP_NET_BIND_SERVICE=+eip /usr/local/bin/frankenphp \
    && chown -R www-data:www-data /config/caddy /data/caddy

# El disco de la app es de solo lectura en Vercel: los archivos temporales
# (Excel subidos/exportados) van a /tmp (APP_STORAGE_PATH, ver bootstrap/app.php)
# y las vistas quedan precompiladas dentro de la imagen (VIEW_COMPILED_PATH).
ENV PORT=80 \
    APP_ENV=production \
    APP_DEBUG=false \
    LOG_CHANNEL=stderr \
    CACHE_STORE=array \
    SESSION_DRIVER=database \
    QUEUE_CONNECTION=sync \
    FILESYSTEM_DISK=local \
    APP_STORAGE_PATH=/tmp/storage \
    DB_EMULATE_PREPARES=true \
    VIEW_COMPILED_PATH=/app/storage/framework/views

USER www-data

CMD ["frankenphp", "run", "--config", "/etc/frankenphp/Caddyfile"]
